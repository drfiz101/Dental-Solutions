rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // DENTAL SOLUTIONS OWNER: can approve, lock and create clinics (cannot read clinic data)
    function isOwner() { return signedIn() && request.auth.token.email in ["fizi101@gmail.com"]; }

    // Al Awan's original email logins (from before Dental Solutions)
    function isLegacyAlawan() { return signedIn() && request.auth.token.email in ["fizi101@gmail.com", "shaziasami.ss@gmail.com"]; }

    function clinicDoc(c) { return /databases/$(database)/documents/clinics/$(c); }
    function memberDoc(c) { return /databases/$(database)/documents/clinics/$(c)/members/$(request.auth.uid); }
    function isMember(c) { return signedIn() && exists(memberDoc(c)) && get(memberDoc(c)).data.active == true; }
    function isClinicAdmin(c) { return isMember(c) && get(memberDoc(c)).data.role == "admin"; }
    function isActive(c) { return exists(clinicDoc(c)) && get(clinicDoc(c)).data.status == "active"; }
    // The owner may clear out a clinic only after marking it "deleted"
    function beingDeleted(c) { return isOwner() && exists(clinicDoc(c)) && get(clinicDoc(c)).data.status == "deleted"; }

    // ---------- Clinics ----------
    match /clinics/{c} {
      allow get: if isOwner() || isMember(c) || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow list: if isOwner();
      // New registrations start as "pending" until the owner approves
      allow create: if isOwner()
        || (signedIn() && c != "alawan" && request.resource.data.ownerUid == request.auth.uid && request.resource.data.status == "pending");
      // Clinic admins may edit their clinic but not approve or unlock it
      allow update: if isOwner()
        || (isClinicAdmin(c) && isActive(c) && request.resource.data.status == resource.data.status && request.resource.data.ownerUid == resource.data.ownerUid);
      allow delete: if isOwner();

      match /members/{uid} {
        allow get: if isOwner() || isMember(c) || request.auth.uid == uid;
        allow list: if isOwner() || isClinicAdmin(c);
        // The owner can create logins for clinics, but not make himself a member of other clinics
        allow create: if (isOwner() && (uid != request.auth.uid || c == "alawan"))
          || (isClinicAdmin(c) && isActive(c))
          || (signedIn() && request.auth.uid == uid && get(clinicDoc(c)).data.ownerUid == uid && request.resource.data.role == "admin")
          || (c == "alawan" && request.auth.uid == uid && isLegacyAlawan() && request.resource.data.role == "staff");
        allow update, delete: if isOwner() || (isClinicAdmin(c) && isActive(c));
      }

      // Password book: only the clinic admin can read; each person can save their own, admins can save anyone's
      match /pwvault/{uid} {
        allow read: if isClinicAdmin(c) && isActive(c);
        allow create, update: if (isClinicAdmin(c) && isActive(c)) || (isMember(c) && request.auth.uid == uid);
        allow delete: if isClinicAdmin(c);
      }

      match /settings/{docId} {
        allow read: if isMember(c) && isActive(c);
        allow write: if isClinicAdmin(c) && isActive(c);
      }

      match /{col}/{docId} {
        allow read, write: if col in ['items', 'logs', 'patients', 'appts', 'bills', 'labcases', 'photos']
          && isMember(c) && isActive(c);
        // Permanent delete of a whole clinic by the Dental Solutions owner
        allow read, delete: if beingDeleted(c);
      }
    }

    // ---------- Username -> current login (used when an admin sets a new password) ----------
    match /logins/{id} {
      allow get: if true;
      allow list: if false;
      allow delete: if isOwner();
      allow create, update: if isClinicAdmin(request.resource.data.code) && isActive(request.resource.data.code)
        && id == request.resource.data.code + "_" + request.resource.data.username;
    }

    // ---------- Online booking page (book.html, for Instagram / Facebook) ----------
    // Anyone may read a clinic's free times (no names, only how busy each time is) and send a booking.
    // Only that clinic's staff can read the bookings.
    function staffOf(c) { return (isMember(c) && isActive(c)) || (c == "alawan" && legacyOnly()); }
    function bookingOn(c) { return exists(/databases/$(database)/documents/publicSlots/$(c)) && get(/databases/$(database)/documents/publicSlots/$(c)).data.on == true; }
    match /publicSlots/{c} {
      allow get: if true;
      allow list: if false;
      allow write: if staffOf(c);
    }
    match /slotHolds/{c}/h/{id} {
      allow read: if true;
      // a time can be held only once (no overwriting), so two patients can't take the same chair and time
      allow create: if bookingOn(c)
        && id.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}_[0-9]{4}_[1-9]$')
        && request.resource.data.keys().hasOnly(['date', 'time', 'at'])
        && request.resource.data.date == id.split('_')[0];
      allow update: if false;
      allow delete: if staffOf(c);
    }
    match /bookings/{c}/items/{id} {
      allow create: if bookingOn(c)
        && request.resource.data.keys().hasOnly(['name', 'phone', 'date', 'time', 'treatment', 'dentist', 'note', 'hold', 'at', 'status', 'src'])
        && request.resource.data.status == "new"
        && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 60
        && request.resource.data.phone is string && request.resource.data.phone.size() >= 10 && request.resource.data.phone.size() <= 16
        && request.resource.data.note is string && request.resource.data.note.size() <= 200
        && request.resource.data.date is string && request.resource.data.time is string;
      allow read, update, delete: if staffOf(c);
    }

    // ---------- Al Awan Dental Clinic data (kept where it always was) ----------
    // The two original emails keep working until their Dental Solutions login exists
    function legacyOnly() { return isLegacyAlawan() && !exists(memberDoc("alawan")); }
    match /settings/{docId} {
      allow read: if (isMember("alawan") && isActive("alawan")) || legacyOnly();
      allow write: if isClinicAdmin("alawan") && isActive("alawan");
    }
    // Logins are turned off with "Login allowed", never deleted, so the old email rule can't come back
    match /{col}/{docId} {
      allow read, write: if col in ['items', 'logs', 'patients', 'appts', 'bills', 'labcases', 'photos']
        && ((isMember("alawan") && isActive("alawan")) || legacyOnly());
    }
  }
}
